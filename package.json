{
  "name": "local-signal-japan",
  "version": "1.0.0",
  "private": true,
  "description": "全国の市区町村の公開統計を、出典・基準年・欠損の注記つきで確認できるダッシュボード",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @local-signal-japan/web dev",
    "build": "pnpm --filter @local-signal-japan/web build",
    "preview": "pnpm --filter @local-signal-japan/web preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "preflight": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm scan:secrets && pnpm build",
    "data:refresh": "tsx packages/dataset/src/refresh.ts",
    "localsignal": "tsx apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.19.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
